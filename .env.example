# ==============================================================================
# ClassPulse AI Environment Configuration
# ==============================================================================

# Server Port
PORT=3001

# ------------------------------------------------------------------------------
# Agora Conversational AI Configuration (Optional - Keyless Browser Fallback if empty)
# ------------------------------------------------------------------------------
# App ID from Agora Console
AGORA_APP_ID=

# App Certificate from Agora Console (Used for server-side token generation)
AGORA_APP_CERTIFICATE=

# REST API Customer ID (for Conversational AI Agent Management)
AGORA_CUSTOMER_ID=

# REST API Customer Secret (for Conversational AI Agent Management)
AGORA_CUSTOMER_SECRET=

# ------------------------------------------------------------------------------
# Webhook & Public Access Configuration (Required only when using Agora Cloud Agent)
# ------------------------------------------------------------------------------
# Shared secret to authenticate requests to /api/agora/llm-webhook
CLASSPULSE_WEBHOOK_SECRET=classpulse_secure_secret_token_12345

# Public URL (e.g., ngrok tunnel: https://xxxx.ngrok-free.app) so Agora cloud can reach backend
CLASSPULSE_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Gemini Live MLLM API Key (Required for Agora Conversational AI Agent)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional LLM API Key (Local RAG & Step-by-Step Math Solver work 100% keyless)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
